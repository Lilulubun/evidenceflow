# Server binding
EVIDENCEFLOW_HOST=127.0.0.1
EVIDENCEFLOW_PORT=8000

# Optional OpenAI-compatible AI. Keep real values only in untracked .env.
EVIDENCEFLOW_AI_ENABLED=false
EVIDENCEFLOW_AI_PROVIDER=openai-compatible
EVIDENCEFLOW_AI_BASE_URL=
EVIDENCEFLOW_AI_CHAT_MODEL=
EVIDENCEFLOW_AI_EMBEDDING_MODEL=
EVIDENCEFLOW_AI_API_KEY=
EVIDENCEFLOW_AI_TEMPERATURE=0
EVIDENCEFLOW_AI_TOKEN_LIMIT=1024
